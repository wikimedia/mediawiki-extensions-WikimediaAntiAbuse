{
	"name": "WikimediaAntiAbuse",
	"author": [
		"Kosta Harlan",
		"Dreamy Jazz"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:WikimediaAntiAbuse",
	"descriptionmsg": "wikimediaantiabuse-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.47.0"
	},
	"MessagesDirs": {
		"WikimediaAntiAbuse": [
			"i18n",
			"i18n/api"
		]
	},
	"DefaultUserOptions": {
		"echo-subscriptions-web-personal-info": false,
		"echo-subscriptions-email-personal-info": false,
		"echo-subscriptions-push-personal-info": false
	},
	"config": {
		"WikimediaAntiAbuseEnablePersonalInfoTag": {
			"value": false,
			"description": "Enables the mw-private-personal-info tag."
		},
		"WikimediaAntiAbuseEnablePersonalInfoFlagNotifications": {
			"value": false,
			"description": "Enables Echo notifications, sent to opted-in users with the viewsuppressed or suppressrevision right, when the mw-private-personal-info tag is applied to a revision. Requires the Echo extension."
		},
		"WikimediaAntiAbuseCoPEModelConfig": {
			"value": {
				"url": "",
				"host": "",
				"timeout": ""
			},
			"description": "Configuration for the CoPE model used for content policy evaluation. Needs to be filled out with the appropriate URL and host. The timeout is optional and when non-empty will be used as the timeout for requests to the CoPE model."
		},
		"WikimediaAntiAbuseDeveloperMode": {
			"value": false,
			"description": "If developer mode is enabled. This should be set to false in production. Developer mode can affect whether e.g. SSL certification validation is enabled in HTTP requests"
		},
		"WikimediaAntiAbuseEnableModelChecks": {
			"value": false,
			"description": "Enables the revision model-check pipeline."
		}
	},
	"HookHandlers": {
		"ChangeTagsHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\ChangeTagsHandler",
			"services": [
				"MainConfig"
			]
		},
		"PageSaveCompleteHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\PageSaveCompleteHandler",
			"services": [
				"MainConfig",
				"JobQueueGroup",
				"ConnectionProvider"
			]
		},
		"NotificationPreferencesHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\NotificationPreferencesHandler",
			"factory": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\NotificationPreferencesHandler::factory",
			"services": [
				"MainConfig",
				"ChangeTagsStore",
				"WikimediaAntiAbuseLogger",
				"ExtensionRegistry"
			]
		},
		"RevisionVisibilityHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\RevisionVisibilityHandler",
			"services": [
				"WikimediaAntiAbusePersonalInfoFlagNotificationModerator"
			]
		},
		"EchoHooksHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Notifications\\EchoHooksHandler",
			"services": [
				"MainConfig"
			]
		},
		"UserRightsNotificationHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\UserRightsNotificationHandler",
			"factory": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\UserRightsNotificationHandler::factory",
			"services": [
				"MainConfig",
				"ChangeTagsStore",
				"UserFactory",
				"ConnectionProvider",
				"ExtensionRegistry"
			]
		}
	},
	"Hooks": {
		"ChangeTagsListActive": "ChangeTagsHandler",
		"ListDefinedTags": "ChangeTagsHandler",
		"ListRestrictedTags": "ChangeTagsHandler",
		"PageSaveComplete": "PageSaveCompleteHandler",
		"GetPreferences": "NotificationPreferencesHandler",
		"ArticleRevisionVisibilitySet": "RevisionVisibilityHandler",
		"BeforeCreateEchoEvent": "EchoHooksHandler",
		"EchoGetBundleRules": "EchoHooksHandler",
		"UserGroupsChanged": "UserRightsNotificationHandler"
	},
	"SpecialPages": {
		"AbuseReview": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Special\\SpecialAbuseReview",
			"services": [
				"ChangeTagsStore",
				"ChangeTagsFormatter",
				"RevisionStore",
				"ArchivedRevisionLookup",
				"LinkBatchFactory",
				"RowCommentFormatter"
			]
		}
	},
	"ResourceModules": {
		"ext.wikimediaAntiAbuse.styles": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "modules/ext.wikimediaAntiAbuse.styles",
			"remoteExtPath": "WikimediaAntiAbuse/modules/ext.wikimediaAntiAbuse.styles",
			"codexStyleOnly": true,
			"codexComponents": [
				"CdxButton",
				"CdxIcon",
				"CdxMessage",
				"CdxProgressIndicator",
				"CdxToggleButton",
				"CdxDialog",
				"CdxField",
				"CdxCheckbox",
				"CdxInfoChip",
				"CdxMultiselectLookup"
			],
			"styles": [
				"special.abuseReview.less"
			]
		},
		"ext.wikimediaAntiAbuse": {
			"class": "MediaWiki\\ResourceLoader\\CodexModule",
			"localBasePath": "modules/ext.wikimediaAntiAbuse",
			"remoteExtPath": "WikimediaAntiAbuse/modules/ext.wikimediaAntiAbuse",
			"codexComponents": [
				"CdxIcon",
				"CdxProgressIndicator",
				"CdxToggleButton",
				"CdxDialog",
				"CdxField",
				"CdxCheckbox",
				"CdxMultiselectLookup"
			],
			"codexScriptOnly": true,
			"packageFiles": [
				"dispatcher.js",
				"mountRowVerdicts.js",
				"components/RowVerdicts.vue",
				"rest.js",
				"utils.js",
				"components/FilterDialog.vue",
				"components/FilterDialogUsernameFilter.vue",
				"mountFilterDialog.js",
				{
					"name": "icons.json",
					"callback": "MediaWiki\\ResourceLoader\\CodexModule::getIcons",
					"callbackParam": [
						"cdxIconCheck",
						"cdxIconClose"
					]
				}
			],
			"dependencies": [
				"mediawiki.api",
				"mediawiki.diff"
			],
			"messages": [
				"wikimediaantiabuse-special-abuse-review-action-mark-false-positive",
				"wikimediaantiabuse-special-abuse-review-action-unmark-false-positive",
				"wikimediaantiabuse-special-abuse-review-action-mark-no-further-action",
				"wikimediaantiabuse-special-abuse-review-action-unmark-no-further-action",
				"wikimediaantiabuse-special-abuse-review-closed-row-note",
				"wikimediaantiabuse-special-abuse-review-already-suppressed-note",
				"wikimediaantiabuse-special-abuse-review-action-in-progress",
				"wikimediaantiabuse-special-abuse-review-action-error",
				"wikimediaantiabuse-special-abuse-review-filter-close",
				"wikimediaantiabuse-special-abuse-review-filter-legend",
				"wikimediaantiabuse-special-abuse-review-show-false-positives",
				"wikimediaantiabuse-special-abuse-review-show-handled-revisions",
				"wikimediaantiabuse-special-abuse-review-filter-submit",
				"wikimediaantiabuse-special-abuse-review-filter-open-button",
				"wikimediaantiabuse-special-abuse-review-filter-username-header",
				"wikimediaantiabuse-special-abuse-review-filter-username-placeholder",
				"wikimediaantiabuse-special-abuse-review-filter-verdicts-header"
			]
		}
	},
	"QUnitTestModule": {
		"localBasePath": "",
		"remoteExtPath": "WikimediaAntiAbuse",
		"packageFiles": [
			"tests/qunit/index.js",
			"tests/qunit/mountRowVerdicts.test.js",
			"tests/qunit/rest.test.js",
			"tests/qunit/components/RowVerdicts.test.js",
			"tests/qunit/utils.test.js",
			"tests/qunit/components/FilterDialog.test.js",
			"tests/qunit/components/FilterDialogUsernameFilter.test.js",
			"tests/qunit/mountFilterDialog.test.js"
		],
		"dependencies": [
			"mediawiki.qunit-testrunner",
			"mediawiki.base",
			"mediawiki.api",
			"ext.wikimediaAntiAbuse",
			"sinonjs",
			"vue-test-utils"
		]
	},
	"ExtensionMessagesFiles": {
		"WikimediaAntiAbuseAliases": "WikimediaAntiAbuse.alias.php"
	},
	"JobClasses": {
		"wikimediaAntiAbuseCheckRevision": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Jobs\\CheckRevisionJob",
			"services": [
				"MainConfig",
				"RevisionLookup",
				"WikimediaAntiAbuseHookRunner",
				"WikimediaAntiAbuseContentPolicyEvaluator",
				"ChangeTagsStore",
				"WikimediaAntiAbusePersonalInfoFlagNotifier",
				"WikimediaAntiAbuseLogger",
				"WikimediaAntiAbuseContentPolicyScoreEventLogger"
			],
			"needsPage": false
		}
	},
	"RestRoutes": [
		{
			"method": "POST",
			"path": "/wikimediaantiabuse/v0/mark/revision/{revision}/{tag}/{verdict}",
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Rest\\Handler\\MarkReviewVerdictHandler",
			"services": [
				"WikimediaAntiAbuseAbuseReviewTagService"
			],
			"openApiSpec": {
				"x-i18n-description": "wikimediaantiabuse-api-review-mark-description"
			}
		},
		{
			"method": "POST",
			"path": "/wikimediaantiabuse/v0/unmark/revision/{revision}/{tag}/{verdict}",
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Rest\\Handler\\UnmarkReviewVerdictHandler",
			"services": [
				"WikimediaAntiAbuseAbuseReviewTagService"
			],
			"openApiSpec": {
				"x-i18n-description": "wikimediaantiabuse-api-review-unmark-description"
			}
		}
	],
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\": "includes/",
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\Maintenance\\": "maintenance/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\Tests\\": "tests/"
	},
	"TestAutoloadClasses": {
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\Tests\\Integration\\Special\\SpecialAbuseReviewTestBase": "tests/phpunit/integration/Special/SpecialAbuseReviewTestBase.php"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"manifest_version": 2
}
