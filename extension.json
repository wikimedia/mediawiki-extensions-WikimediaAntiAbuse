{
	"name": "WikimediaAntiAbuse",
	"author": [
		"Kosta Harlan",
		"Dreamy Jazz"
	],
	"url": "https://www.mediawiki.org/wiki/Special:MyLanguage/Extension:WikimediaAntiAbuse",
	"descriptionmsg": "wikimediaantiabuse-desc",
	"license-name": "GPL-2.0-or-later",
	"type": "other",
	"requires": {
		"MediaWiki": ">= 1.47.0"
	},
	"MessagesDirs": {
		"WikimediaAntiAbuse": [
			"i18n",
			"i18n/api"
		]
	},
	"DefaultUserOptions": {
		"echo-subscriptions-web-personal-info": false,
		"echo-subscriptions-email-personal-info": false
	},
	"config": {
		"WikimediaAntiAbuseEnablePersonalInfoTag": {
			"value": false,
			"description": "Enables the mw-private-personal-info tag."
		},
		"WikimediaAntiAbuseEnablePersonalInfoFlagNotifications": {
			"value": false,
			"description": "Enables Echo notifications, sent to opted-in users with the viewsuppressed or suppressrevision right, when the mw-private-personal-info tag is applied to a revision. Requires the Echo extension."
		},
		"WikimediaAntiAbuseCoPEModelConfig": {
			"value": {
				"url": "",
				"host": "",
				"timeout": ""
			},
			"description": "Configuration for the CoPE model used for content policy evaluation. Needs to be filled out with the appropriate URL and host. The timeout is optional and when non-empty will be used as the timeout for requests to the CoPE model."
		},
		"WikimediaAntiAbuseDeveloperMode": {
			"value": false,
			"description": "If developer mode is enabled. This should be set to false in production. Developer mode can affect whether e.g. SSL certification validation is enabled in HTTP requests"
		},
		"WikimediaAntiAbuseEnableModelChecks": {
			"value": false,
			"description": "Enables the revision model-check pipeline."
		}
	},
	"HookHandlers": {
		"ChangeTagsHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\ChangeTagsHandler",
			"services": [
				"MainConfig"
			]
		},
		"PageSaveCompleteHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\PageSaveCompleteHandler",
			"services": [
				"MainConfig",
				"JobQueueGroup",
				"ConnectionProvider"
			]
		},
		"NotificationPreferencesHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Hooks\\Handlers\\NotificationPreferencesHandler",
			"services": [
				"MainConfig",
				"ChangeTagsStore",
				"WikimediaAntiAbuseLogger",
				"ExtensionRegistry"
			]
		},
		"EchoHooksHandler": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Notifications\\EchoHooksHandler",
			"services": [
				"MainConfig"
			]
		}
	},
	"Hooks": {
		"ChangeTagsListActive": "ChangeTagsHandler",
		"ListDefinedTags": "ChangeTagsHandler",
		"ListRestrictedTags": "ChangeTagsHandler",
		"PageSaveComplete": "PageSaveCompleteHandler",
		"GetPreferences": "NotificationPreferencesHandler",
		"BeforeCreateEchoEvent": "EchoHooksHandler",
		"EchoGetBundleRules": "EchoHooksHandler"
	},
	"SpecialPages": {
		"AbuseReview": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Special\\SpecialAbuseReview",
			"services": [
				"ChangeTagsStore",
				"ChangeTagsFormatter",
				"RevisionStore",
				"UserEditTracker",
				"LinkBatchFactory"
			]
		}
	},
	"ExtensionMessagesFiles": {
		"WikimediaAntiAbuseAliases": "WikimediaAntiAbuse.alias.php"
	},
	"JobClasses": {
		"wikimediaAntiAbuseCheckRevision": {
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Jobs\\CheckRevisionJob",
			"services": [
				"MainConfig",
				"RevisionLookup",
				"WikimediaAntiAbuseHookRunner",
				"WikimediaAntiAbuseContentPolicyEvaluator",
				"ChangeTagsStore",
				"WikimediaAntiAbusePersonalInfoFlagNotifier",
				"WikimediaAntiAbuseLogger"
			],
			"needsPage": false
		}
	},
	"RestRoutes": [
		{
			"method": "POST",
			"path": "/wikimediaantiabuse/v0/mark/revision/{revision}/{tag}/false-positive",
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Rest\\Handler\\MarkFalsePositiveHandler",
			"services": [
				"WikimediaAntiAbuseFalsePositiveTagService"
			],
			"openApiSpec": {
				"x-i18n-description": "wikimediaantiabuse-api-falsepositive-mark-description"
			}
		},
		{
			"method": "POST",
			"path": "/wikimediaantiabuse/v0/unmark/revision/{revision}/{tag}/false-positive",
			"class": "MediaWiki\\Extension\\WikimediaAntiAbuse\\Rest\\Handler\\UnmarkFalsePositiveHandler",
			"services": [
				"WikimediaAntiAbuseFalsePositiveTagService"
			],
			"openApiSpec": {
				"x-i18n-description": "wikimediaantiabuse-api-falsepositive-unmark-description"
			}
		}
	],
	"AutoloadNamespaces": {
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\": "includes/",
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\Maintenance\\": "maintenance/"
	},
	"TestAutoloadNamespaces": {
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\Tests\\": "tests/"
	},
	"TestAutoloadClasses": {
		"MediaWiki\\Extension\\WikimediaAntiAbuse\\Tests\\Integration\\Special\\SpecialAbuseReviewTestBase": "tests/phpunit/integration/Special/SpecialAbuseReviewTestBase.php"
	},
	"ServiceWiringFiles": [
		"includes/ServiceWiring.php"
	],
	"manifest_version": 2
}
